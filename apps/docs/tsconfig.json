{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vite.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["src/.vuefn"],
  "vueCompilerOptions": {
    "plugins": ["@vuefn/core/volar"]
  }
}

{
  "name": "docs",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "vite build && bun scripts/static-files.ts && pagefind --site dist/client",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite dev --host 127.0.0.1 --port 3001",
    "postinstall": "wrangler types",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "typecheck": "vite build --logLevel error && vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@shikijs/langs": "^4.6.0",
    "@tanstack/vue-router": "^1.170.42",
    "@tanstack/vue-start": "^1.169.7",
    "@vuefn/core": "workspace:*",
    "shiki": "^4.6.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "package-manager-detector": "^1.9.0",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "unplugin-vue-markdown": "^32.1.1",
    "vite": "^8.3.8",
    "vite-plugin-pagefind": "^1.1.2",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.166.0"
  }
}

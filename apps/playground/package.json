{
  "name": "playground",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --port 3000",
    "postinstall": "wrangler types",
    "preview": "vite preview",
    "test:e2e": "playwright test && playwright test -c playwright.dev.config.ts",
    "typecheck": "vite build --logLevel error && vue-tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/vue-router": "^1.170.42",
    "@tanstack/vue-start": "^1.169.4",
    "@vuefn/core": "workspace:*",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "pinia": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  }
}

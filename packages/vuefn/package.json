{
  "name": "@pyyupsk/vuefn",
  "version": "0.1.0",
  "description": "One .vue file per route for TanStack Vue Start on Cloudflare Workers",
  "keywords": [
    "cloudflare-workers",
    "tanstack-start",
    "vite-plugin",
    "vue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyyupsk/vuefn.git",
    "directory": "packages/vuefn"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "cp ../../LICENSE ../../README.md .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "magic-string": "^1.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "@tanstack/vue-router": "~1.170.42",
    "@tanstack/vue-start": "~1.169.4",
    "vite": "^8.0.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}

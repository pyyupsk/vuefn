{
  "name": "vuefn",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "changeset": "changeset",
    "dev": "bun run --filter './apps/*' dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run build && bun run --filter playground test:e2e && bun run --filter node-app test:e2e && bun run --filter docs test:e2e",
    "test:pack": "bun run build && bun scripts/pack-test.ts",
    "typecheck": "bun run build && bun run --filter '*' typecheck",
    "version": "changeset version && bun scripts/sync-template.ts && bun install"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint-plugin-jsdoc": "^65.5.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.4.5",
  "patchedDependencies": {
    "@tanstack/vue-router@1.170.42": "patches/@tanstack%2Fvue-router@1.170.42.patch",
    "@pyyupsk/vite-fonts@0.4.1": "patches/@pyyupsk%2Fvite-fonts@0.4.1.patch"
  }
}
